# Generate two DIFFERENT random hex values with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
JWT_SECRET=
# Use URL-safe characters for POSTGRES_PASSWORD, such as generated hex.
DEMO_MODE_ENABLED=true
ENVIRONMENT=development
WEB_PORT=8080
CORS_ORIGINS=["http://localhost:8080"]
# Optional Telegram integration; obtain token from BotFather and keep it private.
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=
# Native backend only (Compose constructs DATABASE_URL automatically):
DATABASE_URL=postgresql+asyncpg://subguard:REPLACE_WITH_PASSWORD@127.0.0.1:5432/subguard

# Optional public HTTPS deployment (compose.production.yaml):
# APP_HOST=subguard.example.com
