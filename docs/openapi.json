  "components": {
    "schemas": {
      "AuthRequest": {
        "properties": {
          "init_data": {
            "type": "string",
            "title": "Init Data",
            "description": "Raw Telegram.WebApp.initData query string"
          }
        },
        "type": "object",
        "required": [
          "init_data"
        ],
        "title": "AuthRequest"
      },
      "BillingInterval": {
        "type": "string",
        "enum": [
          "weekly",
          "monthly",
          "quarterly",
          "semiannual",
          "annual",
          "custom_days"
        ],
        "title": "BillingInterval"
      },
      "CancellationInput": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CancellationStatus",
            "default": "planned"
          },
          "planned_for": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned For"
          },
          "reference_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Note"
          }
        },
        "type": "object",
        "title": "CancellationInput"
      },
      "CancellationStatus": {
        "type": "string",
        "enum": [
          "planned",
          "requested",
          "confirmed",
          "failed"
        ],
        "title": "CancellationStatus"
      },
      "CsvRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 65536,
            "title": "Content"
          },
          "mapping": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 10,
            "title": "Mapping"
          },
          "selected_rows": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Selected Rows"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "CsvRequest"
      },
      "DemoAuthRequest": {
        "properties": {
          "seed": {
            "type": "boolean",
            "title": "Seed",
            "default": true
          }
        },
        "type": "object",
        "title": "DemoAuthRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentInput": {
        "properties": {
          "amount_minor": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Amount Minor"
          },
          "charged_on": {
            "type": "string",
            "format": "date",
            "title": "Charged On"
          },
          "was_expected": {
            "type": "boolean",
            "title": "Was Expected",
            "default": true
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "amount_minor",
          "charged_on"
        ],
        "title": "PaymentInput"
      },
      "Preferences": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "UTC"
          },
          "primary_currency": {
            "type": "string",
            "title": "Primary Currency",
            "default": "TRY"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "en"
          },
          "reminder_days_before": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Reminder Days Before",
            "default": 3
          },
          "trial_reminder_days_before": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Trial Reminder Days Before",
            "default": 2
          },
          "quiet_hours_start": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Quiet Hours Start",
            "default": 22
          },
          "quiet_hours_end": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Quiet Hours End",
            "default": 8
          },
          "notifications_enabled": {
            "type": "boolean",
            "title": "Notifications Enabled",
            "default": true
          }
        },
        "type": "object",
        "title": "Preferences"
      },
      "RefundInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "subscription_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription Id"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Amount Minor"
